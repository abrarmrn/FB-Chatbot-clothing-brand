    {
      "parameters": {
        "jsCode": "// Facebook webhook verification handshake.\n// Set FB_VERIFY_TOKEN env in n8n to whatever you put in the FB App webhook config.\nconst expected = $env.FB_VERIFY_TOKEN || 'change-me-verify-token';\nconst q = $input.first().json.query || {};\nif (q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === expected) {\n  return [{ json: { challenge: q['hub.challenge'] } }];\n}\nreturn [{ json: { error: 'verify failed' }, pairedItem: 0 }];"
      },
