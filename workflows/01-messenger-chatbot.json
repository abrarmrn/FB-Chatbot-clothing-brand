    {
      "parameters": {
        "jsCode": "// Merge user-row (may be empty for new users) with the inbound message.\n// Decide whether the AI should reply at all.\nconst inbound = $('Merge').item.json;\nconst row = $input.first().json || {};\nconst hasRow = !!row.psid;\n\nconst aiEnabledRaw = String(row.ai_enabled || 'TRUE').toUpperCase();\nconst aiEnabled = hasRow ? (aiEnabledRaw === 'TRUE' || aiEnabledRaw === '1') : true;\n\nlet memory = [];\ntry { memory = row.memory ? JSON.parse(row.memory) : []; } catch (e) { memory = []; }\n\nreturn [{\n  json: {\n    psid: inbound.psid,\n    page_id: inbound.page_id,\n    messageText: inbound.messageText,\n    source: inbound.source,\n    user_exists: hasRow,\n    user_name: row.name || '',\n    status: row.status || 'new',\n    followup_count: Number(row.followup_count || 0),\n    ai_enabled: aiEnabled,\n    memory\n  }\n}];"
      },
      "id": "d3333333-3333-3333-3333-333333333333",
