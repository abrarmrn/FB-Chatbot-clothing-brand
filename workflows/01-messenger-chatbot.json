    {
      "parameters": {
        "jsCode": "// Parse the LLM JSON output and decide what side-effects to fire.\nconst prev = $('Build OpenAI Payload').item.json;\nconst raw = $input.first().json;\nconst content = raw.choices && raw.choices[0] && raw.choices[0].message && raw.choices[0].message.content || '{}';\n\nlet ai;\ntry { ai = JSON.parse(content); }\ncatch (e) {\n  ai = { reply: 'Ektu wait koren, ami check kore janacchi.', intent: 'support', needs_human: true, order: {} };\n}\n\nconst reply = (ai.reply || '').toString().slice(0, 240);\nconst intent = ai.intent || 'small_talk';\nconst needsHuman = !!ai.needs_human;\nconst order = ai.order || {};\nconst orderComplete = !!(order.product && order.size && order.quantity && order.address && order.phone);\n\n// Update memory: keep last 5 turns total (user + assistant pairs).\nconst newMemory = [...(prev.memory || []), { role: 'user', content: prev.messageText }, { role: 'assistant', content: reply }].slice(-10);\n\nreturn [{\n  json: {\n    psid: prev.psid,\n    page_id: prev.page_id,\n    user_name: prev.user_name,\n    user_exists: prev.user_exists,\n    status: prev.status,\n    followup_count: prev.followup_count,\n    messageText: prev.messageText,\n    reply,\n    intent,\n    needs_human: needsHuman,\n    order_complete: orderComplete,\n    order,\n    memory_json: JSON.stringify(newMemory),\n    now_iso: new Date().toISOString(),\n    new_status: needsHuman ? 'lead' : (orderComplete ? 'customer' : (prev.status || 'lead')),\n    new_ai_enabled: needsHuman ? 'FALSE' : 'TRUE',\n    order_id: orderComplete ? ('ORD-' + Date.now()) : ''\n  }\n}];"
      },
