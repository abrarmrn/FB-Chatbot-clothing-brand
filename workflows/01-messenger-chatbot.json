      "id": "h1111111-1111-1111-1111-111111111111",
      "name": "Get Products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2560, 460],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_OAUTH", "name": "Google Sheets account" }
      },
      "alwaysOutputData": true
