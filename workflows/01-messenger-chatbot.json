    {
      "parameters": {
        "jsCode": "// Flatten Messenger entry[].messaging[] into one item per user message.\n// Skips delivery / read receipts and anything without a sender id.\nconst body = $input.first().json.body || {};\nconst out = [];\nfor (const entry of body.entry || []) {\n  for (const ev of entry.messaging || []) {\n    if (!ev.sender || !ev.sender.id) continue;\n    if (!ev.message && !ev.postback) continue;\n    if (ev.message && (ev.message.is_echo || ev.delivery || ev.read)) continue;\n    const att = (ev.message && ev.message.attachments) || [];\n    const audio = att.find(a => a.type === 'audio');\n    out.push({\n      json: {\n        psid: ev.sender.id,\n        page_id: ev.recipient && ev.recipient.id,\n        timestamp: ev.timestamp,\n        text: (ev.message && ev.message.text) || (ev.postback && ev.postback.title) || '',\n        audio_url: audio ? audio.payload.url : null,\n        is_audio: !!audio\n      }\n    });\n  }\n}\nreturn out;"
      },
